# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dignitylink?retryWrites=true&w=majority"

# JWT Signing Secret (replace with a strong random secret in production)
JWT_SECRET="dignitylink-dev-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Port (3000 for unified preview; 5000 if running server standalone)
PORT=3000

# Messaging Provider Configuration ('mock' for hackathon prototype; future: 'africas_talking' | 'twilio' | 'whatsapp_cloud')
MESSAGING_PROVIDER_MODE="mock"
MOCK_SMS_SENDER_ID="DignityLink"
MOCK_WHATSAPP_NUMBER="+2348000001234"

# Daily Scheduler Cron Expression (default: 08:00 AM daily)
SCHEDULER_CRON="0 8 * * *"

# Optional Client API Base URL when running client and server on separate origins
VITE_API_URL=""

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
